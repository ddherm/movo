# Copy to .env on the computer running the service. Never paste real credentials
# into the browser or voice call. Keep state on a native disk that supports locks.
VOICE_COMPANION_DATA_DIR=~/.voice-programming-companion
# The folder picker automatically shows the service computer's user folder and
# local disks. Add other parent folders here when needed. Multiple paths use
# ':' on macOS/Linux or ';' on Windows. Leave empty for automatic locations.
PROJECT_STORAGE_ROOTS=

# Required for screenshot understanding, discussion, proposal, and coding.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_AGENT_MODEL=deepseek/deepseek-flash

# Required only when the Chinese voice route is enabled.
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimaxi.chat/v1/t2a_v2
MINIMAX_VOICE_ID=Calm_Woman
MINIMAX_TTS_MODEL=speech-2.8-turbo

# Optional: sourced web research in proposals.
TAVILY_API_KEY=

# Optional: neutral background reminders. Use a random, unguessable topic.
NTFY_TOPIC=
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOKEN=
# Private Tailscale Serve HTTPS URL, for example https://your-mac.your-tailnet.ts.net/
PUBLIC_PROJECT_URL=

# Guardrails for one coding run. Fees depend on the provider's usage accounting.
AGENT_MAX_SECONDS=900
AGENT_MAX_ITERATIONS=35
AGENT_MAX_ACTIONS=80
AGENT_MAX_COST_USD=3
OPENHANDS_SERVER_IMAGE=ghcr.io/openhands/agent-server:1.49.5-python
# Optional; must support Agent file locks (for example APFS or NTFS), not exFAT.
# Empty uses ~/.voice-programming-companion/agent-state.
OPENHANDS_STATE_ROOT=
